# ══════════════════════════════════════════════════════════════════
# SnapSquad Backend — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Environment ──────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── Database (PostgreSQL + pgvector) ─────────────────────────────
# Local dev: postgresql+psycopg://postgres:postgres@localhost:5432/snapsquad
# Supabase:  postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/snapsquad

# ── Redis (for background job queue) ─────────────────────────────
# Local dev: redis://localhost:6379/0
# Upstash:   rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Auth (Firebase) ──────────────────────────────────────────────
# Path to the Firebase Admin SDK service account JSON file.
# Download from: Firebase Console → Project Settings → Service accounts
# Leave empty for local dev without Firebase (auth endpoints will be unavailable).
FIREBASE_CREDENTIALS_JSON=

# ── Cloudflare R2 (encrypted photo blob storage) ─────────────────
# Leave empty for local filesystem storage during development.
# Sign up at dash.cloudflare.com → R2 → Create bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=snapsquad-storage

# ── Local Storage ────────────────────────────────────────────────
DATA_DIR=backend_data

# ── Monitoring (Sentry) ─────────────────────────────────────────
# Get your DSN from sentry.io → Project Settings → Client Keys
SENTRY_DSN=
